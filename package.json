{
    "name": "minivagent",
    "description": "A node-based generative AI workspace",
    "license": "Apache-2.0",
    "private": true,
    "version": "1.1.0",
    "type": "module",
    "bin": {
        "minivagent": "agent/index.js"
    },
    "scripts": {
        "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
        "dev:compiled": "concurrently \"npm run build:watch\" \"npm run dev:server\"",
        "dev:client": "vite",
        "dev:server": "node --watch --experimental-strip-types server/index.ts",
        "build": "vite build",
        "build:watch": "vite build --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@google/genai": "^2.21.0",
        "@langchain/google-genai": "^2.3.0",
        "@langchain/langgraph": "^1.4.14",
        "@types/three": "^0.185.4",
        "axios": "^1.20.0",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "langchain": "^1.5.10",
        "lucide-react": "^0.577.0",
        "multer": "^2.3.0",
        "openai": "^7.10.0",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "react-markdown": "^10.1.0",
        "replicate": "^1.4.0",
        "sharp": "^0.35.4",
        "sonner": "^2.0.7",
        "three": "^0.185.1",
        "uuid": "^13.0.0",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/multer": "^2.1.0",
        "@types/node": "^25.9.5",
        "@types/supertest": "^7.2.0",
        "@types/uuid": "^11.0.0",
        "@vitejs/plugin-react": "^5.2.0",
        "@vitest/coverage-v8": "^4.1.11",
        "concurrently": "^9.2.4",
        "supertest": "^7.2.2",
        "typescript": "~5.9.3",
        "vite": "^7.3.6",
        "vitest": "^4.1.11"
    },
    "overrides": {
        "protobufjs": ">=7.5.5"
    }
}
